{
  "schema": "embodiedflow.codex_plugin/1",
  "name": "embodiedflow",
  "version": "1.0.0",
  "description": "具身智能研发平台：数据、训练、评测、部署与视觉能力的 MCP 工具与核心 Skills",
  "mcp": {
    "transport": "stdio",
    "command": "ops/mcp_stdio.sh",
    "http": {
      "url": "http://<SERVER_HOST>:18081/mcp",
      "transport": "streamable-http"
    }
  },
  "tools": {
    "count": 43,
    "sha256_12": "df5d40db8fd1"
  },
  "skills": [
    {
      "name": "data-readiness",
      "title": "数据就绪检查与清洗",
      "path": "skills/data-readiness/SKILL.md",
      "inputs": [
        "project_id",
        "dataset_version_id",
        "max_episodes",
        "min_completeness"
      ],
      "outputs": [
        "ready",
        "quality",
        "checked_episodes",
        "bad_episodes",
        "clean_plan",
        "next_action"
      ]
    },
    {
      "name": "train-launch",
      "title": "训练发起与守护",
      "path": "skills/train-launch/SKILL.md",
      "inputs": [
        "project_id",
        "dataset_version_id",
        "backend",
        "epochs",
        "lr",
        "batch_size",
        "device"
      ],
      "outputs": [
        "job_id",
        "status",
        "metrics",
        "model_version_id",
        "failure_reason"
      ]
    },
    {
      "name": "eval-deploy",
      "title": "评测到部署",
      "path": "skills/eval-deploy/SKILL.md",
      "inputs": [
        "project_id",
        "model_version_id",
        "benchmark",
        "deploy"
      ],
      "outputs": [
        "evaluation_id",
        "metrics",
        "registered",
        "deployment",
        "verdict"
      ]
    },
    {
      "name": "vision-annotate",
      "title": "视觉标注与审核",
      "path": "skills/vision-annotate/SKILL.md",
      "inputs": [
        "project_id",
        "dataset_version_id",
        "episode",
        "camera"
      ],
      "outputs": [
        "masks",
        "review_status",
        "quality_flags",
        "next_action"
      ]
    }
  ],
  "entrypoints": {
    "api": "/workbench/api/capabilities",
    "skills": "/workbench/api/agent/skills",
    "tools": "/workbench/api/agent/tools"
  }
}